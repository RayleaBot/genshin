{
  "id": "raylea.genshin",
  "name": "原神",
  "version": "0.1.0",
  "manifest_version": "4",
  "min_core_version": "0.7.0",
  "license": "AGPL-3.0-only",
  "metadata": {
    "description": "原神独立查询、离线图鉴、公开展柜与抽卡档案",
    "author": "raylea"
  },
  "concurrency": 4,
  "events": [
    "message.private",
    "message.group",
    "config.changed",
    "scheduler.trigger",
    "notice.poke"
  ],
  "default_config": {
    "account_provider": "raylea.mihoyo-accounts",
    "image_replies": true,
    "custom_aliases": {}
  },
  "commands": [
    {
      "id": "profile",
      "name": "角色卡片",
      "description": "原神信息",
      "usage": "#角色卡片 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "信息",
          "角色卡片",
          "角色3",
          "探索",
          "探险",
          "探索度",
          "探险度",
          "宝箱",
          "成就",
          "尘歌壶",
          "家园",
          "声望"
        ]
      }
    },
    {
      "id": "note",
      "name": "体力",
      "description": "原神实时便笺",
      "usage": "#体力 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "体力",
          "树脂",
          "查询体力",
          "便笺",
          "便签",
          "全部体力",
          "多体力"
        ]
      }
    },
    {
      "id": "characters",
      "name": "角色",
      "description": "原神角色列表",
      "usage": "#角色 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "角色",
          "查询",
          "角色查询",
          "查询角色",
          "人物",
          "五星角色",
          "四星角色"
        ]
      }
    },
    {
      "id": "tcg_cards",
      "name": "七圣查询牌",
      "description": "七圣召唤已有的角色牌与行动牌",
      "usage": "#七圣查询[角色|行动]牌 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:七圣(?:召唤)?查询(?:角色|行动)?(?:卡)?牌(?:列表)?|牌库)$"
      }
    },
    {
      "id": "tcg_decks",
      "name": "七圣查询牌组",
      "description": "七圣召唤全部牌组，带编号时查看该牌组",
      "usage": "#七圣查询牌组[编号] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:七圣(?:召唤)?查询(?:牌|卡)组(?:列表)?(?:[0-9]{1,2})?|牌组)$"
      }
    },
    {
      "id": "monthly-history",
      "name": "原石统计",
      "description": "保存官方仍提供的月份后，统计最近十二个月或指定年份的原石与摩拉",
      "usage": "#[去年|今年|2025年]原石统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:去年|今年|[0-9]{4}年)?(?:原石|札记|月报)统计$"
      }
    },
    {
      "id": "training",
      "name": "练度统计",
      "description": "全部角色的等级、命座、天赋、武器与圣遗物评分",
      "usage": "#练度统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:面板|喵喵)?练度统计$"
      }
    },
    {
      "id": "talent-stat",
      "name": "天赋统计",
      "description": "全部角色的天赋等级、周本材料与天赋书，可按今日、明日、周几或星级筛选",
      "usage": "#[今日|明日|周一][五星]天赋统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:我的)?(?:今日|今天|明日|明天|周.*)?(?:[五四54]星)?(?:技能|天赋)+(?:汇总|统计|列表)?$"
      }
    },
    {
      "id": "talent-wiki",
      "name": "角色天赋",
      "description": "角色的天赋、被动与命之座资料",
      "usage": "#胡桃天赋 / #胡桃命座",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+?)(?:天赋|技能|命座|命之座)$"
      }
    },
    {
      "id": "accounts",
      "name": "账号",
